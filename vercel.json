{
  "rewrites": [
    { "source": "/mini-app", "destination": "/mini-app/index.html" },
    { "source": "/mini-app/", "destination": "/mini-app/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
