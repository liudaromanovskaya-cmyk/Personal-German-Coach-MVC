{
  "base_name": "Personal German Coach",
  "description": "Airtable база данных для платформы Personal German Coach",
  "tables": [
    {
      "name": "Students",
      "description": "Профили студентов",
      "fields": [
        { "name": "student_id", "type": "autonumber", "primary": true },
        { "name": "full_name", "type": "single_line_text", "required": true },
        { "name": "email", "type": "email", "required": true },
        { "name": "phone", "type": "phone_number" },
        { "name": "city", "type": "single_line_text" },
        { "name": "country", "type": "single_select", "options": ["Deutschland", "Schweiz", "Österreich", "Russland", "Ukraine", "Kasachstan", "Other"] },
        { "name": "profession", "type": "single_line_text" },
        { "name": "profession_category", "type": "single_select", "options": ["IT/Tech", "Medizin/Pflege", "Ingenieur", "Pädagogik", "Finanzen", "Management", "Handwerk", "Andere"] },
        { "name": "main_goal", "type": "single_select", "options": ["Integration", "Exam_prep", "Career", "University", "Citizenship", "Personal"] },
        { "name": "target_exam", "type": "single_select", "options": ["Goethe_A1", "Goethe_A2", "Goethe_B1", "Goethe_B2", "Goethe_C1", "TestDaF", "telc", "DSH", "None"] },
        { "name": "deadline", "type": "date" },
        { "name": "cefr_initial", "type": "single_select", "options": ["A1", "A2", "B1", "B2", "C1", "C2"] },
        { "name": "cefr_current", "type": "single_select", "options": ["A1", "A2", "B1", "B2", "C1", "C2"] },
        { "name": "self_listening", "type": "number", "min": 1, "max": 5 },
        { "name": "self_reading", "type": "number", "min": 1, "max": 5 },
        { "name": "self_writing", "type": "number", "min": 1, "max": 5 },
        { "name": "self_speaking", "type": "number", "min": 1, "max": 5 },
        { "name": "self_grammar", "type": "number", "min": 1, "max": 5 },
        { "name": "accuracy_percent", "type": "number", "description": "% правильных ответов в диагностических тестах" },
        { "name": "fluency_score", "type": "number", "min": 1, "max": 5 },
        { "name": "pronunciation_score", "type": "number", "min": 1, "max": 5 },
        { "name": "listening_comprehension", "type": "number", "description": "% правильных ответов в listening тесте" },
        { "name": "reading_comprehension", "type": "number", "description": "% правильных ответов в reading тесте" },
        { "name": "learning_style", "type": "single_select", "options": ["Visual", "Auditory", "Kinesthetic", "Analytical"] },
        { "name": "psych_barriers", "type": "multiple_select", "options": ["Fear_of_mistakes", "Slow_recall", "Native_speaker_anxiety", "Accent_shame", "Vocabulary_gap", "Grammar_confusion", "No_practice_partner", "Uncertain_level"] },
        { "name": "homework_time_minutes", "type": "number" },
        { "name": "preferred_formats", "type": "multiple_select", "options": ["Audio_QA", "Reading_writing", "Audio_recording", "Fill_in_blanks", "Mini_texts", "Vocabulary_cards", "Roleplay"] },
        { "name": "previous_certificate", "type": "single_select", "options": ["None", "A1", "A2", "B1", "B2", "C1", "C2"] },
        { "name": "status", "type": "single_select", "options": ["Lead", "Active", "Paused", "Completed", "Churned"] },
        { "name": "subscription_plan", "type": "single_select", "options": ["Free_trial", "Feed_only", "Intensive_8h", "Strategic_track", "Premium_mentorship"] },
        { "name": "start_date", "type": "date" },
        { "name": "teacher_id", "type": "link_to_table", "linked_table": "Teachers" },
        { "name": "plans", "type": "link_to_table", "linked_table": "Plans" },
        { "name": "gdpr_data_consent", "type": "checkbox" },
        { "name": "gdpr_audio_consent", "type": "checkbox" },
        { "name": "gdpr_ai_consent", "type": "checkbox" },
        { "name": "gdpr_consent_date", "type": "datetime" },
        { "name": "onboarding_audio_url", "type": "url" },
        { "name": "notes", "type": "long_text" },
        { "name": "created_at", "type": "created_time" },
        { "name": "updated_at", "type": "last_modified_time" }
      ]
    },
    {
      "name": "Teachers",
      "description": "Профили преподавателей",
      "fields": [
        { "name": "teacher_id", "type": "autonumber", "primary": true },
        { "name": "full_name", "type": "single_line_text", "required": true },
        { "name": "email", "type": "email", "required": true },
        { "name": "role", "type": "single_select", "options": ["Admin", "Teacher", "Reviewer"] },
        { "name": "specializations", "type": "multiple_select", "options": ["Exam_prep", "Business_German", "Integration", "Kids", "Pronunciation"] },
        { "name": "students", "type": "link_to_table", "linked_table": "Students" },
        { "name": "calendly_url", "type": "url" },
        { "name": "active", "type": "checkbox", "default": true },
        { "name": "created_at", "type": "created_time" }
      ]
    },
    {
      "name": "Plans",
      "description": "Персональные учебные планы",
      "fields": [
        { "name": "plan_id", "type": "autonumber", "primary": true },
        { "name": "plan_name", "type": "single_line_text" },
        { "name": "student_id", "type": "link_to_table", "linked_table": "Students" },
        { "name": "teacher_id", "type": "link_to_table", "linked_table": "Teachers" },
        { "name": "plan_type", "type": "single_select", "options": ["Weekly", "Monthly", "Exam_sprint", "Custom"] },
        { "name": "start_date", "type": "date" },
        { "name": "end_date", "type": "date" },
        { "name": "cefr_target", "type": "single_select", "options": ["A1", "A2", "B1", "B2", "C1", "C2"] },
        { "name": "focus_skills", "type": "multiple_select", "options": ["Listening", "Reading", "Writing", "Speaking", "Grammar", "Vocabulary", "Pronunciation"] },
        { "name": "weekly_sessions", "type": "number", "description": "Количество занятий в неделю" },
        { "name": "homework_per_week", "type": "number" },
        { "name": "professional_lexis_topic", "type": "single_line_text", "description": "Профессиональная лексика (напр. IT, Medizin)" },
        { "name": "plan_content", "type": "long_text", "description": "Сгенерированный AI план (DRAFT) — JSON или Markdown" },
        { "name": "ai_generated", "type": "checkbox", "description": "Был ли план сгенерирован AI" },
        { "name": "teacher_approved", "type": "checkbox" },
        { "name": "status", "type": "single_select", "options": ["Draft", "Active", "Completed", "Archived"] },
        { "name": "assignments", "type": "link_to_table", "linked_table": "Assignments" },
        { "name": "notes", "type": "long_text" },
        { "name": "created_at", "type": "created_time" },
        { "name": "updated_at", "type": "last_modified_time" }
      ]
    },
    {
      "name": "Assignments",
      "description": "Домашние задания",
      "fields": [
        { "name": "assignment_id", "type": "autonumber", "primary": true },
        { "name": "title", "type": "single_line_text", "required": true },
        { "name": "assignment_type", "type": "single_select", "options": ["Listening_summary", "Dictation", "Cloze", "Mini_email", "Sentence_correction", "Pronunciation_drill", "Roleplay", "Reading_comprehension", "Vocabulary_set", "Mini_presentation", "Custom"] },
        { "name": "skill_focus", "type": "multiple_select", "options": ["Listening", "Reading", "Writing", "Speaking", "Grammar", "Vocabulary", "Pronunciation"] },
        { "name": "cefr_level", "type": "single_select", "options": ["A1", "A2", "B1", "B2", "C1", "C2"] },
        { "name": "duration_minutes", "type": "number", "description": "Стандартное время выполнения" },
        { "name": "instructions", "type": "long_text", "required": true },
        { "name": "checklist", "type": "long_text", "description": "Критерии проверки" },
        { "name": "example_answer", "type": "long_text" },
        { "name": "resources_url", "type": "url", "description": "Ссылка на аудио/текст/видео материал" },
        { "name": "plan_id", "type": "link_to_table", "linked_table": "Plans" },
        { "name": "student_id", "type": "link_to_table", "linked_table": "Students" },
        { "name": "due_date", "type": "date" },
        { "name": "status", "type": "single_select", "options": ["Assigned", "In_progress", "Submitted", "Reviewed", "Archived"] },
        { "name": "submissions", "type": "link_to_table", "linked_table": "Submissions" },
        { "name": "professional_context", "type": "single_line_text", "description": "Профессиональный контекст задания (напр. Arztpraxis, IT-Meeting)" },
        { "name": "created_at", "type": "created_time" }
      ]
    },
    {
      "name": "Submissions",
      "description": "Сданные домашние задания студентов",
      "fields": [
        { "name": "submission_id", "type": "autonumber", "primary": true },
        { "name": "assignment_id", "type": "link_to_table", "linked_table": "Assignments" },
        { "name": "student_id", "type": "link_to_table", "linked_table": "Students" },
        { "name": "submitted_at", "type": "datetime" },
        { "name": "submission_type", "type": "single_select", "options": ["Audio", "Text", "File", "Mixed"] },
        { "name": "text_content", "type": "long_text", "description": "Текстовый ответ студента" },
        { "name": "audio_url", "type": "url", "description": "Ссылка на аудиофайл в Drive/S3" },
        { "name": "file_url", "type": "url" },
        { "name": "transcript", "type": "long_text", "description": "Транскрипт аудио (Whisper API)" },
        { "name": "transcript_status", "type": "single_select", "options": ["Pending", "Processing", "Done", "Error"] },
        { "name": "auto_tags", "type": "multiple_select", "options": ["Grammatikfehler", "Aussprache", "Wortschatz", "Satzstruktur", "Kasus", "Verb_konj", "Artikel", "Praepositionen", "Gut"] },
        { "name": "draft_comment", "type": "long_text", "description": "DRAFT — автоматический AI-комментарий (не верифицирован)" },
        { "name": "ai_error_list", "type": "long_text", "description": "DRAFT — список ошибок от AI" },
        { "name": "teacher_comment", "type": "long_text", "description": "Финальный комментарий преподавателя (верифицированный)" },
        { "name": "teacher_score", "type": "number", "min": 0, "max": 10 },
        { "name": "teacher_reviewed_at", "type": "datetime" },
        { "name": "teacher_reviewed_by", "type": "link_to_table", "linked_table": "Teachers" },
        { "name": "review_status", "type": "single_select", "options": ["AI_draft_ready", "Teacher_review_pending", "Teacher_reviewed", "Sent_to_student"] },
        { "name": "anki_words", "type": "long_text", "description": "CSV строки для Anki (слово;перевод;пример)" },
        { "name": "created_at", "type": "created_time" }
      ]
    },
    {
      "name": "Progress",
      "description": "Прогресс студента по времени",
      "fields": [
        { "name": "progress_id", "type": "autonumber", "primary": true },
        { "name": "student_id", "type": "link_to_table", "linked_table": "Students" },
        { "name": "record_date", "type": "date", "required": true },
        { "name": "period_type", "type": "single_select", "options": ["Weekly", "Monthly", "Post_exam", "Checkpoint"] },
        { "name": "cefr_level", "type": "single_select", "options": ["A1", "A2", "B1", "B2", "C1", "C2"] },
        { "name": "accuracy_percent", "type": "number" },
        { "name": "fluency_score", "type": "number", "min": 1, "max": 5 },
        { "name": "pronunciation_score", "type": "number", "min": 1, "max": 5 },
        { "name": "listening_score", "type": "number", "min": 0, "max": 100 },
        { "name": "reading_score", "type": "number", "min": 0, "max": 100 },
        { "name": "writing_score", "type": "number", "min": 0, "max": 10 },
        { "name": "speaking_score", "type": "number", "min": 0, "max": 10 },
        { "name": "assignments_completed", "type": "number" },
        { "name": "assignments_total", "type": "number" },
        { "name": "top_errors", "type": "long_text", "description": "Топ-5 ошибок за период" },
        { "name": "focus_next_period", "type": "long_text" },
        { "name": "teacher_summary", "type": "long_text" },
        { "name": "report_url", "type": "url", "description": "Ссылка на PDF отчёт" },
        { "name": "created_at", "type": "created_time" }
      ]
    }
  ]
}
