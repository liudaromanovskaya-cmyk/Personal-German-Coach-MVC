{
  "rules": {
    "teacher": {
      "$studentId": {
        ".read": true,
        ".write": "auth != null"
      }
    },
    "submissions": {
      "$studentId": {
        ".read": "auth != null",
        ".write": true
      }
    },
    "progress": {
      "$studentId": {
        ".read": true,
        ".write": true
      }
    },
    "students": {
      "$studentId": {
        ".read": true,
        ".write": "auth != null"
      }
    }
  }
}
